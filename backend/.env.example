# Salin file ini menjadi .env (di folder backend yang sama), lalu isi nilainya.
# File .env tidak boleh dibagikan atau di-commit karena berisi kunci rahasia.

# Opsional: mengaktifkan analisis Claude di halaman AI RCA Assistant.
# Buat kunci di https://console.anthropic.com  (tanpa kunci ini, fitur lain tetap berjalan)
ANTHROPIC_API_KEY=

# Opsional: model Claude yang dipakai
# CATALYTECH_LLM_MODEL=claude-opus-5

# Opsional: tanggal awal simulasi, kecepatan awal (jam simulasi per detik), dan autoplay
# CATALYTECH_START=2026-01-05T08:00
# CATALYTECH_SPEED=24
# CATALYTECH_AUTOPLAY=0

# Opsional: alamat server (0.0.0.0 agar bisa dibuka dari komputer lain di jaringan yang sama)
# HOST=127.0.0.1
# PORT=8000
