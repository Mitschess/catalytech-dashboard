# Salin file ini menjadi .env (di folder backend yang sama), lalu isi nilainya.
# File .env tidak boleh dibagikan atau di-commit karena bisa berisi kunci rahasia.

# ------------------------------------------------------------------ Asisten RCA
# local  = model jalan di komputer sendiri lewat Ollama / LM Studio (default).
#          Data proses tidak keluar dari jaringan, tanpa kunci API dan tanpa kuota.
# claude = Anthropic API (butuh ANTHROPIC_API_KEY di bawah).
# CATALYTECH_LLM_PROVIDER=local

# Model yang dipakai. Untuk GPU 4 GB, qwen2.5:3b muat penuh dan cepat.
# Pasang lebih dulu: ollama pull qwen2.5:3b
# CATALYTECH_LLM_MODEL=qwen2.5:3b

# Alamat server lokal. Ollama = port 11434, LM Studio = http://127.0.0.1:1234/v1
# Bisa juga diarahkan ke PC lain di jaringan, misal http://192.168.1.10:11434/v1
# CATALYTECH_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Batas panjang jawaban dan batas waktu tunggu (detik). Naikkan timeout kalau pakai CPU saja.
# CATALYTECH_LLM_MAX_TOKENS=1500
# CATALYTECH_LLM_TIMEOUT=300

# Hanya perlu kalau CATALYTECH_LLM_PROVIDER=claude. Buat kunci di https://console.anthropic.com
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ Simulator
# Opsional: tanggal awal simulasi, kecepatan awal (jam simulasi per detik), dan autoplay
# CATALYTECH_START=2026-01-05T08:00
# CATALYTECH_SPEED=24
# CATALYTECH_AUTOPLAY=0

# Opsional: alamat server (0.0.0.0 agar bisa dibuka dari komputer lain di jaringan yang sama)
# HOST=127.0.0.1
# PORT=8000
